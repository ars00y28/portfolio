---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import homeData from '../data/home.json';

const projects = await getCollection('projects');
// Sort by date descending
const sortedProjects = projects.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<Layout title="Projects | Mechatronics Portfolio">
    <section class="py-12">
        <div class="flex justify-between items-start mb-6">
            <h1 class="text-4xl font-extrabold text-gray-900">{homeData.title}</h1>
            <button id="open-add-project" class="admin-only bg-blue-600 text-white px-4 py-2 rounded-md hover:bg-blue-700 font-bold shadow-sm whitespace-nowrap">+ Add Project</button>
        </div>
        <p class="text-xl text-gray-600 mb-12 max-w-2xl">
            {homeData.subtitle}
        </p>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
            {sortedProjects.map(project => (
                <a href={`/projects/${project.id}`} class="block group">
                    <div class="bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden hover:shadow-md transition-shadow">
                        <div class="h-48 bg-gray-200 w-full overflow-hidden">
                            {project.data.image ? (
                                <img src={project.data.image} alt={project.data.title} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" />
                            ) : (
                                <div class="w-full h-full flex items-center justify-center text-gray-400">No Image provided</div>
                            )}
                        </div>
                        <div class="p-6">
                            <h2 class="text-xl font-bold text-gray-900 mb-2 group-hover:text-blue-600 transition-colors">{project.data.title}</h2>
                            <p class="text-gray-600 text-sm mb-4 line-clamp-2">{project.data.description}</p>
                            
                            <div class="flex flex-wrap gap-2">
                                {project.data.skills.slice(0, 3).map(skill => (
                                    <span class="px-2 py-1 bg-blue-50 text-blue-700 text-xs font-medium rounded-md">{skill}</span>
                                ))}
                                {project.data.skills.length > 3 && (
                                    <span class="px-2 py-1 bg-gray-50 text-gray-600 text-xs font-medium rounded-md">+{project.data.skills.length - 3}</span>
                                )}
                            </div>
                        </div>
                    </div>
                </a>
            ))}
        </div>
    </section>

    <!-- Admin Add Project Modal -->
    <div id="add-project-modal" class="fixed inset-0 bg-black/50 backdrop-blur-sm hidden items-center justify-center z-50 p-4">
        <div class="bg-white rounded-xl shadow-lg p-8 max-w-2xl w-full max-h-[90vh] overflow-y-auto relative">
            <button id="close-modal-btn" class="absolute top-4 right-4 text-gray-500 hover:text-gray-800 font-bold text-xl">&times;</button>
            <h2 class="text-2xl font-bold mb-6">Add New Project</h2>
            <form id="project-form" class="space-y-4">
                <div>
                    <label class="block text-sm font-bold text-gray-700 mb-1">Project Title</label>
                    <input type="text" id="p-title" required class="w-full px-4 py-2 border rounded-md outline-none focus:ring-2 focus:ring-blue-500" placeholder="E.g., Autonomous Robot">
                </div>
                <div>
                    <label class="block text-sm font-bold text-gray-700 mb-1">Short Description</label>
                    <input type="text" id="p-desc" required class="w-full px-4 py-2 border rounded-md outline-none focus:ring-2 focus:ring-blue-500" placeholder="A brief summary">
                </div>
                <div>
                    <label class="block text-sm font-bold text-gray-700 mb-1">Date</label>
                    <input type="date" id="p-date" required class="w-full px-4 py-2 border rounded-md outline-none focus:ring-2 focus:ring-blue-500">
                </div>
                <div>
                    <label class="block text-sm font-bold text-gray-700 mb-1">Skills (comma separated)</label>
                    <input type="text" id="p-skills" required class="w-full px-4 py-2 border rounded-md outline-none focus:ring-2 focus:ring-blue-500" placeholder="C++, ROS, CAD">
                </div>
                <div>
                    <div class="flex justify-between items-center mb-1">
                        <label class="block text-sm font-bold text-gray-700">Documentation (Markdown)</label>
                        <div class="relative overflow-hidden inline-block cursor-pointer bg-gray-100 border border-gray-300 text-gray-700 text-xs font-bold py-1 px-2 rounded hover:bg-gray-200">
                            <span id="p-upload-text">Upload Image/Video</span>
                            <input type="file" id="p-media" accept="image/*,video/*" class="absolute left-0 top-0 opacity-0 cursor-pointer w-full h-full">
                        </div>
                    </div>
                    <textarea id="p-body" required rows="8" class="w-full px-4 py-2 border rounded-md outline-none focus:ring-2 focus:ring-blue-500 font-mono text-sm" placeholder="## Documentation&#10;Write here..."></textarea>
                </div>
                <button type="submit" id="submit-btn" class="w-full bg-blue-600 text-white px-6 py-3 rounded-md hover:bg-blue-700 font-bold">Publish Project</button>
                <div id="status-msg" class="text-center font-bold text-sm mt-2 hidden"></div>
            </form>
        </div>
    </div>

    <script>
        const REPO = 'ars00y28/portfolio';
        const modal = document.getElementById('add-project-modal');
        const openBtn = document.getElementById('open-add-project');
        const closeBtn = document.getElementById('close-modal-btn');
        const projectForm = document.getElementById('project-form');
        const submitBtn = document.getElementById('submit-btn');
        const statusMsg = document.getElementById('status-msg');
        const mediaInput = document.getElementById('p-media');
        const bodyInput = document.getElementById('p-body');
        const uploadText = document.getElementById('p-upload-text');

        if(openBtn) openBtn.addEventListener('click', () => { modal.style.display = 'flex'; document.getElementById('p-date').valueAsDate = new Date(); });
        if(closeBtn) closeBtn.addEventListener('click', () => { modal.style.display = 'none'; });

        // Media Uploader
        if(mediaInput) mediaInput.addEventListener('change', async (e) => {
            const file = e.target.files[0];
            if(!file) return;
            const token = localStorage.getItem('gh_token');
            if (!token) return alert('No GitHub token found!');
            
            uploadText.textContent = "Uploading...";
            try {
                // Convert to base64
                const reader = new FileReader();
                reader.readAsDataURL(file);
                reader.onload = async () => {
                    const base64Content = reader.result.split(',')[1];
                    const safeName = Date.now() + '-' + file.name.replace(/[^a-zA-Z0-9.-]/g, '_');
                    const path = `public/images/${safeName}`;
                    
                    const res = await fetch(`https://api.github.com/repos/${REPO}/contents/${path}`, {
                        method: 'PUT',
                        headers: { 'Authorization': `token ${token}`, 'Content-Type': 'application/json' },
                        body: JSON.stringify({ message: `Upload media: ${file.name}`, content: base64Content })
                    });
                    
                    if(res.ok) {
                        const markdownTag = file.type.startsWith('video/') 
                            ? `\n<video controls class="w-full rounded-lg shadow-sm my-4"><source src="/images/${safeName}" type="${file.type}"></video>\n` 
                            : `\n![${file.name}](/images/${safeName})\n`;
                        
                        bodyInput.value += markdownTag;
                        alert("Uploaded successfully! Tag appended to documentation.");
                    } else {
                        throw new Error(await res.text());
                    }
                };
            } catch (err) {
                alert("Upload failed: " + err.message);
            } finally {
                uploadText.textContent = "Upload Image/Video";
                mediaInput.value = "";
            }
        });

        if(projectForm) projectForm.addEventListener('submit', async (e) => {
            e.preventDefault();
            const token = localStorage.getItem('gh_token');
            if (!token) return alert('No GitHub token found! Please login via the Admin Dashboard.');

            submitBtn.disabled = true;
            submitBtn.textContent = "Publishing...";
            statusMsg.classList.add('hidden');

            const title = document.getElementById('p-title').value;
            const desc = document.getElementById('p-desc').value;
            const date = document.getElementById('p-date').value;
            const skillsRaw = document.getElementById('p-skills').value;
            const body = document.getElementById('p-body').value;

            const skillsStr = skillsRaw.split(',').map(s => `"${s.trim()}"`).join(', ');
            const markdown = `---\ntitle: "${title.replace(/"/g, '\\"')}"\ndescription: "${desc.replace(/"/g, '\\"')}"\ndate: ${date}\nskills: [${skillsStr}]\n---\n${body}`;
            const filename = title.toLowerCase().replace(/[^a-z0-9]+/g, '-') + '.md';
            const path = `src/content/projects/${filename}`;

            try {
                const encodedContent = btoa(unescape(encodeURIComponent(markdown)));
                const response = await fetch(`https://api.github.com/repos/${REPO}/contents/${path}`, {
                    method: 'PUT',
                    headers: { 'Authorization': `token ${token}`, 'Content-Type': 'application/json' },
                    body: JSON.stringify({ message: `Add project: ${title}`, content: encodedContent })
                });

                if (response.ok) {
                    statusMsg.textContent = "✅ Published! Live in 60s.";
                    statusMsg.className = "text-center font-bold text-sm mt-2 text-green-600 block";
                    setTimeout(() => { modal.style.display = 'none'; projectForm.reset(); }, 2000);
                } else {
                    const error = await response.json();
                    throw new Error(error.message || "Failed to publish");
                }
            } catch (err) {
                statusMsg.textContent = "❌ Error: " + err.message;
                statusMsg.className = "text-center font-bold text-sm mt-2 text-red-600 block";
            } finally {
                submitBtn.disabled = false;
                submitBtn.textContent = "Publish Project";
            }
        });
    </script>
</Layout>
