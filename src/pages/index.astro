---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Aditya Raj Sharma | Home">
  <div id="hero-wrapper" class="min-h-[80vh] flex flex-col items-center justify-center relative overflow-hidden bg-slate-50 rounded-3xl border border-slate-200">
    
    <!-- Title Text -->
    <div id="intro-text" class="absolute top-12 text-center transition-all duration-700 ease-in-out">
      <h1 class="text-3xl md:text-5xl font-black text-slate-900 tracking-tight">Aditya Raj Sharma</h1>
      <p class="text-lg md:text-xl text-slate-500 font-medium mt-2">Select a hemisphere to explore.</p>
    </div>

    <!-- The Brain Container -->
    <div id="brain-container" class="relative w-[300px] h-[300px] md:w-[400px] md:h-[400px] flex items-center justify-center mt-12 transition-all duration-700 ease-in-out z-10">
      <!-- Left Hemisphere (Logic) -->
      <div id="left-hemisphere" class="absolute right-1/2 w-1/2 h-full cursor-pointer group origin-right transition-all duration-500 z-20">
        <img src="/images/left-brain.svg" class="absolute right-2 top-0 w-[198px] h-full object-contain drop-shadow-md group-hover:drop-shadow-xl transition-all duration-300" />
        <!-- Overlay Text -->
        <div class="absolute inset-0 flex items-center justify-center -translate-x-12 opacity-0 group-hover:opacity-100 transition-opacity duration-300">
          <span class="bg-slate-800 text-white font-bold px-4 py-2 rounded-full text-sm shadow-lg transform -rotate-12">Logic & Systems</span>
        </div>
      </div>

      <!-- Right Hemisphere (Creative) -->
      <div id="right-hemisphere" class="absolute left-1/2 w-1/2 h-full cursor-pointer group origin-left transition-all duration-500 z-20">
        <img src="/images/right-brain.svg" class="absolute left-2 top-0 w-[198px] h-full object-contain drop-shadow-md group-hover:drop-shadow-xl transition-all duration-300" />
        <!-- Overlay Text -->
        <div class="absolute inset-0 flex items-center justify-center translate-x-12 opacity-0 group-hover:opacity-100 transition-opacity duration-300">
          <span class="bg-slate-800 text-white font-bold px-4 py-2 rounded-full text-sm shadow-lg transform rotate-12">Art & Creation</span>
        </div>
      </div>
    </div>

    <!-- Nodes Container (Hidden initially) -->
    <div id="nodes-container" class="absolute inset-0 pointer-events-none z-30 flex items-center justify-center">
      <!-- Left Nodes -->
      <a href="/engineering" class="left-node node-link opacity-0 absolute text-2xl md:text-3xl font-black text-slate-700 hover:text-slate-900 transition-colors pointer-events-auto drop-shadow-md">Engineering</a>
      <a href="/engineering" class="left-node node-link opacity-0 absolute text-2xl md:text-3xl font-black text-slate-700 hover:text-slate-900 transition-colors pointer-events-auto drop-shadow-md">Software</a>
      <a href="/cv" class="left-node node-link opacity-0 absolute text-2xl md:text-3xl font-black text-slate-700 hover:text-slate-900 transition-colors pointer-events-auto drop-shadow-md">Curriculum Vitae</a>
      
      <!-- Right Nodes -->
      <a href="/art" class="right-node node-link opacity-0 absolute text-2xl md:text-3xl font-black text-slate-700 hover:text-slate-900 transition-colors pointer-events-auto drop-shadow-md">Fine Art</a>
      <a href="/cooking" class="right-node node-link opacity-0 absolute text-2xl md:text-3xl font-black text-slate-700 hover:text-slate-900 transition-colors pointer-events-auto drop-shadow-md">Cooking</a>
      <a href="/writings" class="right-node node-link opacity-0 absolute text-2xl md:text-3xl font-black text-slate-700 hover:text-slate-900 transition-colors pointer-events-auto drop-shadow-md">Writings</a>
    </div>

    <!-- Back Button (Hidden initially) -->
    <button id="reset-btn" class="absolute bottom-12 opacity-0 pointer-events-none bg-slate-900 text-white px-6 py-3 rounded-full font-bold hover:bg-slate-800 transition-all duration-300 z-40 flex items-center shadow-lg">
      <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>
      Back to Brain
    </button>
  </div>

  <style>
    /* Hover effects for the hemispheres */
    #left-hemisphere:hover { transform: scale(1.05) rotate(-2deg); }
    #right-hemisphere:hover { transform: scale(1.05) rotate(2deg); }

    /* Active Animation States */
    .state-left-active #left-hemisphere {
      transform: scale(1.2) translateX(30%);
      color: #334155 !important; /* slate-700 */
      opacity: 0.15;
    }
    .state-left-active #right-hemisphere {
      transform: scale(0.8) translateX(50%);
      opacity: 0;
      pointer-events: none;
    }
    
    .state-right-active #right-hemisphere {
      transform: scale(1.2) translateX(-30%);
      color: #334155 !important; /* slate-700 */
      opacity: 0.15;
    }
    .state-right-active #left-hemisphere {
      transform: scale(0.8) translateX(-50%);
      opacity: 0;
      pointer-events: none;
    }

    .state-active #intro-text {
      opacity: 0;
      transform: translateY(-20px);
      pointer-events: none;
    }

    /* Node Animations */
    .node-link {
      transition: all 0.6s cubic-bezier(0.34, 1.56, 0.64, 1);
    }
    
    .state-left-active .left-node {
      opacity: 1 !important;
    }
    .state-left-active .left-node:nth-child(1) { transform: translate(-25vw, -15vh) scale(1); }
    .state-left-active .left-node:nth-child(2) { transform: translate(-35vw, 0px) scale(1); }
    .state-left-active .left-node:nth-child(3) { transform: translate(-25vw, 15vh) scale(1); }

    .state-right-active .right-node {
      opacity: 1 !important;
    }
    .state-right-active .right-node:nth-child(4) { transform: translate(25vw, -15vh) scale(1); }
    .state-right-active .right-node:nth-child(5) { transform: translate(35vw, 0px) scale(1); }
    .state-right-active .right-node:nth-child(6) { transform: translate(25vw, 15vh) scale(1); }
  </style>

  <script>
    const leftHemi = document.getElementById('left-hemisphere');
    const rightHemi = document.getElementById('right-hemisphere');
    const wrapper = document.getElementById('hero-wrapper');
    const resetBtn = document.getElementById('reset-btn');

    leftHemi?.addEventListener('click', () => {
      wrapper?.classList.add('state-left-active', 'state-active');
      if(resetBtn) {
        resetBtn.classList.remove('opacity-0', 'pointer-events-none');
        resetBtn.classList.add('opacity-100', 'pointer-events-auto');
      }
    });

    rightHemi?.addEventListener('click', () => {
      wrapper?.classList.add('state-right-active', 'state-active');
      if(resetBtn) {
        resetBtn.classList.remove('opacity-0', 'pointer-events-none');
        resetBtn.classList.add('opacity-100', 'pointer-events-auto');
      }
    });

    resetBtn?.addEventListener('click', () => {
      wrapper?.classList.remove('state-left-active', 'state-right-active', 'state-active');
      resetBtn.classList.add('opacity-0', 'pointer-events-none');
      resetBtn.classList.remove('opacity-100', 'pointer-events-auto');
    });
  </script>
</Layout>
