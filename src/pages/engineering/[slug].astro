---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
    const projects = await getCollection('engineering');
    return projects.map(entry => ({
        params: { slug: entry.id },
        props: { entry },
    }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<Layout title={`${entry.data.title} | Engineering`}>
  <article class="max-w-4xl mx-auto reveal-on-scroll">
    <header class="mb-12">
      <h1 class="text-4xl md:text-6xl font-black text-slate-900 mb-4">{entry.data.title}</h1>
      <p class="text-xl text-slate-500 mb-8">{entry.data.date.toDateString()}</p>
      
      {entry.data.video ? (
        <div class="w-full rounded-2xl overflow-hidden shadow-lg bg-slate-900 mb-8 max-h-[70vh] flex justify-center">
          <video src={entry.data.video} controls class="w-full h-full object-contain max-h-[70vh]"></video>
        </div>
      ) : entry.data.image ? (
        <div class="w-full mb-8 flex justify-center">
          <img src={entry.data.image} alt={entry.data.title} class="max-w-full h-auto rounded-2xl shadow-lg max-h-[70vh] object-contain bg-slate-50 border border-slate-200" />
        </div>
      ) : null}
    </header>

    <div class="prose prose-lg prose-slate max-w-none mx-auto">
      {(entry.data.github || entry.data.demo) && (
        <div class="not-prose flex flex-wrap gap-4 mb-10 justify-start">
          {entry.data.github && (
            <a href={entry.data.github} target="_blank" rel="noopener noreferrer" class="inline-flex items-center px-6 py-3 bg-slate-900 text-white font-bold rounded-full hover:bg-slate-800 transition-colors shadow-md hover:shadow-lg">
              <svg class="w-5 h-5 mr-2" fill="currentColor" viewBox="0 0 24 24"><path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd"></path></svg>
              View Repository
            </a>
          )}
          {entry.data.demo && (
            <a href={entry.data.demo} target="_blank" rel="noopener noreferrer" class="inline-flex items-center px-6 py-3 bg-blue-600 text-white font-bold rounded-full hover:bg-blue-700 transition-colors shadow-md hover:shadow-lg">
              <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path></svg>
              Live Visualization
            </a>
          )}
        </div>
      )}
      
      <Content />
    </div>
  </article>
</Layout>
