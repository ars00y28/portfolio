---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
    const projects = await getCollection('writings');
    return projects.map(entry => ({
        params: { slug: entry.id },
        props: { entry },
    }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<Layout title={`${entry.data.title} | Writings`}>
  <article class="max-w-4xl mx-auto reveal-on-scroll">
    <header class="mb-12 text-center">
      <h1 class="text-4xl md:text-6xl font-black text-slate-900 mb-4">{entry.data.title}</h1>
      <p class="text-xl text-slate-500 mb-8">{entry.data.date.toDateString()}</p>
    </header>

    {entry.data.video ? (
      <div class="w-full rounded-2xl overflow-hidden shadow-2xl bg-slate-900 mb-12 max-h-[80vh] flex justify-center">
        <video src={entry.data.video} controls class="w-full h-full object-contain max-h-[80vh]"></video>
      </div>
    ) : entry.data.image ? (
      <div class="w-full rounded-2xl overflow-hidden shadow-2xl bg-slate-100 mb-12 max-h-[80vh] flex justify-center cursor-pointer hover:opacity-95 transition-opacity" onclick="this.classList.toggle('fixed'); this.classList.toggle('inset-0'); this.classList.toggle('z-50'); this.classList.toggle('bg-black/90'); this.classList.toggle('p-8'); this.querySelector('img').classList.toggle('object-contain'); this.querySelector('img').classList.toggle('object-cover');">
        <img src={entry.data.image} alt={entry.data.title} class="w-full h-full object-cover transition-all duration-300" />
      </div>
    ) : null}

    <div class="prose prose-lg prose-slate max-w-2xl mx-auto text-center md:text-left">
      <Content />
    </div>
  </article>
</Layout>
