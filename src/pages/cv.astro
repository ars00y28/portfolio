---
import Layout from '../layouts/Layout.astro';
import cv from '../data/cv.json';
---

<Layout title="Curriculum Vitae | Portfolio">
  <div class="max-w-4xl mx-auto reveal-on-scroll">
    <div class="flex flex-col md:flex-row justify-between items-start md:items-center mb-12 gap-6 md:gap-0">
      <div class="flex items-center gap-6">
        {cv.image && (
          <img src={cv.image} alt={cv.name} class="w-24 h-24 sm:w-32 sm:h-32 rounded-full object-cover shadow-lg border-4 border-white" />
        )}
        <div>
          <h1 class="text-4xl sm:text-5xl font-black text-slate-900 tracking-tight">{cv.name}</h1>
          <p class="text-xl sm:text-2xl text-blue-600 font-medium mt-2">{cv.title}</p>
        </div>
      </div>
      
      <a href="/Aditya_CV.pdf" download class="mt-6 md:mt-0 inline-flex items-center bg-slate-900 text-white px-6 py-3 rounded-full font-bold hover:bg-blue-600 transition-colors shadow-lg hover:shadow-xl group">
        <svg class="w-5 h-5 mr-2 group-hover:-translate-y-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path></svg>
        Download PDF
      </a>
    </div>

    <div class="bg-white rounded-3xl shadow-sm border border-slate-200 p-8 md:p-12">
      <!-- Contact Info -->
      <div class="flex flex-wrap gap-6 text-slate-600 border-b border-slate-100 pb-8 mb-8">
        <div class="flex items-center">
          <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
          {cv.contact.email}
        </div>
        <div class="flex items-center">
          <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path></svg>
          {cv.contact.phone}
        </div>
        <div class="flex items-center">
          <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
          {cv.contact.location}
        </div>
      </div>

      <!-- Summary -->
      <section class="mb-12">
        <h2 class="text-2xl font-bold text-slate-900 mb-4 tracking-tight">Professional Summary</h2>
        <p class="text-lg text-slate-600 leading-relaxed">{cv.summary}</p>
      </section>

      <!-- Experience -->
      <section class="mb-12">
        <h2 class="text-2xl font-bold text-slate-900 mb-6 tracking-tight">Experience</h2>
        <div class="space-y-8">
          {cv.experience.map(exp => (
            <div class="relative pl-8 before:content-[''] before:absolute before:left-0 before:top-2 before:w-3 before:h-3 before:bg-blue-600 before:rounded-full before:shadow-[0_0_0_4px_#eff6ff]">
              <div class="flex flex-col sm:flex-row justify-between sm:items-center mb-2">
                <h3 class="text-xl font-bold text-slate-900">{exp.role}</h3>
                <span class="text-blue-600 font-medium font-mono text-sm">{exp.date}</span>
              </div>
              <p class="text-slate-500 font-medium mb-3">{exp.company}</p>
              <p class="text-slate-600">{exp.description}</p>
            </div>
          ))}
        </div>
      </section>

      <!-- Education -->
      <section class="mb-12">
        <h2 class="text-2xl font-bold text-slate-900 mb-6 tracking-tight">Education</h2>
        <div class="space-y-8">
          {cv.education.map(edu => (
            <div class="relative pl-8 before:content-[''] before:absolute before:left-0 before:top-2 before:w-3 before:h-3 before:bg-slate-300 before:rounded-full">
              <div class="flex flex-col sm:flex-row justify-between sm:items-center mb-2">
                <h3 class="text-xl font-bold text-slate-900">{edu.degree}</h3>
                <span class="text-slate-500 font-medium font-mono text-sm">{edu.date}</span>
              </div>
              <p class="text-slate-600">{edu.institution}</p>
            </div>
          ))}
        </div>
      </section>

      <!-- Skills -->
      <section class="mb-12">
        <h2 class="text-2xl font-bold text-slate-900 mb-6 tracking-tight">Skills</h2>
        <div class="flex flex-wrap gap-3">
          {cv.skills.map((skill: string) => (
            <span class="bg-slate-100 text-slate-700 px-4 py-2 rounded-lg font-medium text-sm hover:bg-blue-50 hover:text-blue-700 transition-colors cursor-default">
              {skill}
            </span>
          ))}
        </div>
      </section>

      <!-- Languages -->
      {cv.Language && (
        <section>
          <h2 class="text-2xl font-bold text-slate-900 mb-6 tracking-tight">Languages</h2>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            {cv.Language.map((lang: any) => (
              <div class="bg-white border border-slate-200 rounded-xl p-4 shadow-sm flex justify-between items-center">
                <span class="font-bold text-slate-800">{lang.Language}</span>
                <span class="bg-blue-50 text-blue-700 text-xs font-bold px-3 py-1 rounded-full">{lang.Fluency}</span>
              </div>
            ))}
          </div>
        </section>
      )}
    </div>
  </div>
</Layout>
