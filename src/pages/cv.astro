---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import cvData from '../data/cv.json';

// Dynamically extract skills from all Mechatronics projects
const allProjects = await getCollection('projects');
const allSkills = new Set<string>();

allProjects.forEach(project => {
    project.data.skills.forEach(skill => {
        allSkills.add(skill);
    });
});

const sortedSkills = Array.from(allSkills).sort();
---

<Layout title="Curriculum Vitae | Mechatronics Portfolio">
    <div class="py-12 max-w-4xl mx-auto bg-white p-10 rounded-xl shadow-sm border border-gray-100 mt-8">
        <header class="border-b border-gray-200 pb-8 mb-8 flex flex-col md:flex-row justify-between md:items-end gap-4">
            <div>
                <h1 class="text-4xl font-extrabold text-gray-900 mb-2">{cvData.name}</h1>
                <h2 class="text-xl text-blue-600 font-medium">{cvData.title}</h2>
                <p class="text-gray-500 mt-2">{cvData.subtitle}</p>
            </div>
            <div class="text-left md:text-right text-sm text-gray-500 flex flex-col gap-1">
                {cvData.contact.email && <p>Email: {cvData.contact.email}</p>}
                {cvData.contact.github && <p>GitHub: {cvData.contact.github}</p>}
                {cvData.contact.linkedin && <p>LinkedIn: {cvData.contact.linkedin}</p>}
            </div>
        </header>

        <section class="mb-10">
            <h3 class="text-2xl font-bold text-gray-900 border-b-2 border-gray-100 pb-2 mb-4">Education</h3>
            {cvData.education.map(edu => (
                <div class="mb-4">
                    <div class="flex justify-between font-bold text-gray-800">
                        <span>{edu.degree}</span>
                        <span>{edu.duration}</span>
                    </div>
                    <div class="text-gray-600 italic">{edu.institution}</div>
                </div>
            ))}
        </section>

        {cvData.experience && cvData.experience.length > 0 && (
            <section class="mb-10">
                <h3 class="text-2xl font-bold text-gray-900 border-b-2 border-gray-100 pb-2 mb-4">Experience</h3>
                {cvData.experience.map(exp => (
                    <div class="mb-4">
                        <div class="flex justify-between font-bold text-gray-800">
                            <span>{exp.role}</span>
                            <span>{exp.duration}</span>
                        </div>
                        <div class="text-gray-600 italic mb-1">{exp.company}</div>
                        <p class="text-gray-700 text-sm">{exp.description}</p>
                    </div>
                ))}
            </section>
        )}

        <section class="mb-10">
            <h3 class="text-2xl font-bold text-gray-900 border-b-2 border-gray-100 pb-2 mb-4">Technical Skills (Auto-Generated)</h3>
            <p class="text-sm text-gray-500 mb-4 italic">Note: These skills are automatically aggregated from the skills tags on your Mechatronics project pages.</p>
            <div class="flex flex-wrap gap-2">
                {sortedSkills.length > 0 ? (
                    sortedSkills.map(skill => (
                        <span class="px-3 py-1.5 bg-gray-100 text-gray-800 font-medium text-sm rounded-md border border-gray-200">
                            {skill}
                        </span>
                    ))
                ) : (
                    <p class="text-gray-500">Add some projects to automatically populate your skills!</p>
                )}
            </div>
        </section>

        <section class="mb-10">
            <h3 class="text-2xl font-bold text-gray-900 border-b-2 border-gray-100 pb-2 mb-4">Key Projects</h3>
            <ul class="space-y-4">
                {allProjects.map(project => (
                    <li>
                        <div class="flex justify-between font-bold text-gray-800">
                            <span>{project.data.title}</span>
                            <span>{project.data.date.getFullYear()}</span>
                        </div>
                        <p class="text-gray-600 text-sm mt-1">{project.data.description}</p>
                    </li>
                ))}
            </ul>
        </section>
        
        <div class="text-center mt-12 print:hidden flex justify-center gap-4">
            <button class="bg-blue-600 hover:bg-blue-700 text-white font-bold py-2 px-6 rounded shadow cursor-pointer" onclick="window.print()">
                Print / Save as PDF
            </button>
            <button id="open-edit-cv" class="admin-only bg-green-600 hover:bg-green-700 text-white font-bold py-2 px-6 rounded shadow cursor-pointer">
                Edit CV
            </button>
        </div>
    </div>

    <!-- Admin Edit CV Modal -->
    <div id="edit-cv-modal" class="fixed inset-0 bg-black/50 backdrop-blur-sm hidden items-center justify-center z-50 p-4">
        <div class="bg-white rounded-xl shadow-lg p-8 max-w-4xl w-full max-h-[90vh] overflow-y-auto relative">
            <button id="close-cv-btn" class="absolute top-4 right-4 text-gray-500 hover:text-gray-800 font-bold text-xl">&times;</button>
            <h2 class="text-2xl font-bold mb-6">Edit CV</h2>
            
            <form id="cv-form" class="space-y-6">
                <!-- Basic Info -->
                <div class="grid grid-cols-2 gap-4">
                    <div><label class="block text-sm font-bold text-gray-700">Full Name</label><input type="text" id="cv-name" class="w-full px-3 py-2 border rounded"></div>
                    <div><label class="block text-sm font-bold text-gray-700">Professional Title</label><input type="text" id="cv-title" class="w-full px-3 py-2 border rounded"></div>
                </div>
                <div><label class="block text-sm font-bold text-gray-700">Objective / Subtitle</label><input type="text" id="cv-subtitle" class="w-full px-3 py-2 border rounded"></div>
                
                <!-- Contact Info -->
                <h3 class="text-lg font-bold border-b pb-2">Contact Info</h3>
                <div class="grid grid-cols-3 gap-4">
                    <div><label class="block text-sm font-bold text-gray-700">Email</label><input type="text" id="cv-email" class="w-full px-3 py-2 border rounded"></div>
                    <div><label class="block text-sm font-bold text-gray-700">GitHub</label><input type="text" id="cv-github" class="w-full px-3 py-2 border rounded"></div>
                    <div><label class="block text-sm font-bold text-gray-700">LinkedIn</label><input type="text" id="cv-linkedin" class="w-full px-3 py-2 border rounded"></div>
                </div>

                <!-- Experience -->
                <div class="flex justify-between items-center border-b pb-2">
                    <h3 class="text-lg font-bold">Experience</h3>
                    <button type="button" id="add-exp-btn" class="text-sm bg-blue-100 text-blue-700 px-3 py-1 rounded font-bold hover:bg-blue-200">+ Add</button>
                </div>
                <div id="exp-container" class="space-y-4"></div>

                <!-- Education -->
                <div class="flex justify-between items-center border-b pb-2">
                    <h3 class="text-lg font-bold">Education</h3>
                    <button type="button" id="add-edu-btn" class="text-sm bg-blue-100 text-blue-700 px-3 py-1 rounded font-bold hover:bg-blue-200">+ Add</button>
                </div>
                <div id="edu-container" class="space-y-4"></div>
                
                <button type="submit" id="cv-submit-btn" class="w-full bg-green-600 text-white px-6 py-3 rounded-md hover:bg-green-700 font-bold">Save CV Updates</button>
                <div id="cv-status-msg" class="text-center font-bold text-sm mt-2 hidden"></div>
            </form>
        </div>
    </div>

    <script>
        const REPO = 'ars00y28/portfolio';
        const cvModal = document.getElementById('edit-cv-modal');
        const cvOpenBtn = document.getElementById('open-edit-cv');
        const cvCloseBtn = document.getElementById('close-cv-btn');
        const expContainer = document.getElementById('exp-container');
        const eduContainer = document.getElementById('edu-container');
        
        let currentSha = null;

        function createExpRow(exp = {role: '', company: '', duration: '', description: ''}) {
            const div = document.createElement('div');
            div.className = 'exp-item p-4 border rounded bg-gray-50 relative grid grid-cols-2 gap-3';
            div.innerHTML = `
                <button type="button" class="absolute top-2 right-2 text-red-500 font-bold hover:text-red-700" onclick="this.parentElement.remove()">X</button>
                <div><label class="block text-xs font-bold text-gray-600">Role</label><input type="text" class="e-role w-full px-2 py-1 border rounded" value="${exp.role}"></div>
                <div><label class="block text-xs font-bold text-gray-600">Company</label><input type="text" class="e-company w-full px-2 py-1 border rounded" value="${exp.company}"></div>
                <div class="col-span-2"><label class="block text-xs font-bold text-gray-600">Duration</label><input type="text" class="e-duration w-full px-2 py-1 border rounded" value="${exp.duration}"></div>
                <div class="col-span-2"><label class="block text-xs font-bold text-gray-600">Description</label><textarea class="e-desc w-full px-2 py-1 border rounded" rows="2">${exp.description}</textarea></div>
            `;
            expContainer.appendChild(div);
        }

        function createEduRow(edu = {degree: '', institution: '', duration: ''}) {
            const div = document.createElement('div');
            div.className = 'edu-item p-4 border rounded bg-gray-50 relative grid grid-cols-2 gap-3';
            div.innerHTML = `
                <button type="button" class="absolute top-2 right-2 text-red-500 font-bold hover:text-red-700" onclick="this.parentElement.remove()">X</button>
                <div class="col-span-2"><label class="block text-xs font-bold text-gray-600">Degree</label><input type="text" class="ed-degree w-full px-2 py-1 border rounded" value="${edu.degree}"></div>
                <div><label class="block text-xs font-bold text-gray-600">Institution</label><input type="text" class="ed-inst w-full px-2 py-1 border rounded" value="${edu.institution}"></div>
                <div><label class="block text-xs font-bold text-gray-600">Duration</label><input type="text" class="ed-duration w-full px-2 py-1 border rounded" value="${edu.duration}"></div>
            `;
            eduContainer.appendChild(div);
        }

        document.getElementById('add-exp-btn').addEventListener('click', () => createExpRow());
        document.getElementById('add-edu-btn').addEventListener('click', () => createEduRow());

        if(cvOpenBtn) cvOpenBtn.addEventListener('click', async () => { 
            cvModal.style.display = 'flex'; 
            try {
                const res = await fetch(`https://api.github.com/repos/${REPO}/contents/src/data/cv.json`);
                const data = await res.json();
                currentSha = data.sha;
                const cvData = JSON.parse(decodeURIComponent(escape(atob(data.content))));
                
                document.getElementById('cv-name').value = cvData.name || '';
                document.getElementById('cv-title').value = cvData.title || '';
                document.getElementById('cv-subtitle').value = cvData.subtitle || '';
                document.getElementById('cv-email').value = cvData.contact?.email || '';
                document.getElementById('cv-github').value = cvData.contact?.github || '';
                document.getElementById('cv-linkedin').value = cvData.contact?.linkedin || '';
                
                expContainer.innerHTML = '';
                (cvData.experience || []).forEach(createExpRow);
                eduContainer.innerHTML = '';
                (cvData.education || []).forEach(createEduRow);
            } catch(err) {
                alert("Failed to load CV data. " + err.message);
                cvModal.style.display = 'none';
            }
        });
        
        if(cvCloseBtn) cvCloseBtn.addEventListener('click', () => { cvModal.style.display = 'none'; });

        const cvForm = document.getElementById('cv-form');
        if(cvForm) cvForm.addEventListener('submit', async (e) => {
            e.preventDefault();
            const token = localStorage.getItem('gh_token');
            if (!token) return alert('No GitHub token found!');

            const newCvData = {
                name: document.getElementById('cv-name').value,
                title: document.getElementById('cv-title').value,
                subtitle: document.getElementById('cv-subtitle').value,
                contact: {
                    email: document.getElementById('cv-email').value,
                    github: document.getElementById('cv-github').value,
                    linkedin: document.getElementById('cv-linkedin').value
                },
                experience: Array.from(document.querySelectorAll('.exp-item')).map(el => ({
                    role: el.querySelector('.e-role').value,
                    company: el.querySelector('.e-company').value,
                    duration: el.querySelector('.e-duration').value,
                    description: el.querySelector('.e-desc').value
                })),
                education: Array.from(document.querySelectorAll('.edu-item')).map(el => ({
                    degree: el.querySelector('.ed-degree').value,
                    institution: el.querySelector('.ed-inst').value,
                    duration: el.querySelector('.ed-duration').value
                }))
            };

            const cvSubmitBtn = document.getElementById('cv-submit-btn');
            const cvStatusMsg = document.getElementById('cv-status-msg');
            cvSubmitBtn.disabled = true;
            cvSubmitBtn.textContent = "Saving...";
            cvStatusMsg.classList.add('hidden');

            try {
                const encodedContent = btoa(unescape(encodeURIComponent(JSON.stringify(newCvData, null, 2))));
                const response = await fetch(`https://api.github.com/repos/${REPO}/contents/src/data/cv.json`, {
                    method: 'PUT',
                    headers: { 'Authorization': `token ${token}`, 'Content-Type': 'application/json' },
                    body: JSON.stringify({ message: `Update CV via Admin`, content: encodedContent, sha: currentSha })
                });
                if (response.ok) {
                    cvStatusMsg.textContent = "✅ CV Updated! Live in 60s.";
                    cvStatusMsg.className = "text-center font-bold text-sm mt-2 text-green-600 block";
                    setTimeout(() => { window.location.reload(); }, 2000);
                } else throw new Error("Failed to publish");
            } catch (err) {
                cvStatusMsg.textContent = "❌ Error: " + err.message;
                cvStatusMsg.className = "text-center font-bold text-sm mt-2 text-red-600 block";
            } finally {
                cvSubmitBtn.disabled = false;
                cvSubmitBtn.textContent = "Save CV Updates";
            }
        });
    </script>
</Layout>
