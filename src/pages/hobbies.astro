---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const allHobbies = await getCollection('hobbies');
const sortedHobbies = allHobbies.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<Layout title="Personal Interests | Mechatronics Portfolio">
    <section class="py-12">
        <header class="mb-12">
            <div class="flex justify-between items-start mb-4">
                <h1 class="text-4xl font-extrabold text-gray-900">Personal Interests</h1>
                <button id="open-add-hobby" class="admin-only bg-blue-600 text-white px-4 py-2 rounded-md hover:bg-blue-700 font-bold shadow-sm whitespace-nowrap">+ Add Interest</button>
            </div>
            <p class="text-xl text-gray-600 max-w-3xl">
                Beyond mechatronics, I am passionate about painting, sketching, writing, and human psychology. These interests shape my creative approach to engineering problems and human-centered design.
            </p>
        </header>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
            {sortedHobbies.map(hobby => (
                <div class="bg-white rounded-lg shadow-sm border border-gray-100 overflow-hidden hover:shadow-md transition-shadow">
                     <div class="h-64 bg-gray-200 w-full overflow-hidden relative">
                        {hobby.data.image ? (
                            <img src={hobby.data.image} alt={hobby.data.title} class="w-full h-full object-cover" />
                        ) : (
                            <div class="w-full h-full flex flex-col items-center justify-center text-gray-400 p-4 text-center">
                                <span class="font-bold text-gray-300 text-2xl mb-2">{hobby.data.category}</span>
                                <span>No Image uploaded yet</span>
                            </div>
                        )}
                        <span class="absolute top-4 right-4 bg-white/90 backdrop-blur-sm text-gray-800 text-xs font-bold px-3 py-1 rounded-full shadow-sm">
                            {hobby.data.category}
                        </span>
                    </div>
                    <div class="p-6">
                        <h2 class="text-xl font-bold text-gray-900 mb-2">{hobby.data.title}</h2>
                        <time class="text-xs text-gray-500 font-medium block mb-4">{hobby.data.date.toLocaleDateString()}</time>
                        <div class="flex flex-wrap gap-2">
                            {hobby.data.tags.map(tag => (
                                <span class="px-2 py-1 bg-gray-100 text-gray-600 text-xs rounded-md border border-gray-200">#{tag}</span>
                            ))}
                        </div>
                    </div>
                </div>
            ))}
        </div>
    </section>

    <!-- Admin Add Hobby Modal -->
    <div id="add-hobby-modal" class="fixed inset-0 bg-black/50 backdrop-blur-sm hidden items-center justify-center z-50 p-4">
        <div class="bg-white rounded-xl shadow-lg p-8 max-w-2xl w-full max-h-[90vh] overflow-y-auto relative">
            <button id="close-hobby-btn" class="absolute top-4 right-4 text-gray-500 hover:text-gray-800 font-bold text-xl">&times;</button>
            <h2 class="text-2xl font-bold mb-6">Add New Interest</h2>
            <form id="hobby-form" class="space-y-4">
                <div>
                    <label class="block text-sm font-bold text-gray-700 mb-1">Title</label>
                    <input type="text" id="h-title" required class="w-full px-4 py-2 border rounded-md outline-none focus:ring-2 focus:ring-blue-500">
                </div>
                <div>
                    <label class="block text-sm font-bold text-gray-700 mb-1">Category (e.g. Painting)</label>
                    <input type="text" id="h-category" required class="w-full px-4 py-2 border rounded-md outline-none focus:ring-2 focus:ring-blue-500">
                </div>
                <div>
                    <label class="block text-sm font-bold text-gray-700 mb-1">Tags (comma separated)</label>
                    <input type="text" id="h-tags" class="w-full px-4 py-2 border rounded-md outline-none focus:ring-2 focus:ring-blue-500">
                </div>
                <div>
                    <label class="block text-sm font-bold text-gray-700 mb-1">Date</label>
                    <input type="date" id="h-date" required class="w-full px-4 py-2 border rounded-md outline-none focus:ring-2 focus:ring-blue-500">
                </div>
                <button type="submit" id="h-submit-btn" class="w-full bg-blue-600 text-white px-6 py-3 rounded-md hover:bg-blue-700 font-bold">Publish Interest</button>
                <div id="h-status-msg" class="text-center font-bold text-sm mt-2 hidden"></div>
            </form>
        </div>
    </div>

    <script>
        const REPO = 'ars00y28/portfolio';
        const hModal = document.getElementById('add-hobby-modal');
        const hOpenBtn = document.getElementById('open-add-hobby');
        const hCloseBtn = document.getElementById('close-hobby-btn');
        const hForm = document.getElementById('hobby-form');
        const hSubmitBtn = document.getElementById('h-submit-btn');
        const hStatusMsg = document.getElementById('h-status-msg');

        if(hOpenBtn) hOpenBtn.addEventListener('click', () => { hModal.style.display = 'flex'; document.getElementById('h-date').valueAsDate = new Date(); });
        if(hCloseBtn) hCloseBtn.addEventListener('click', () => { hModal.style.display = 'none'; });

        if(hForm) hForm.addEventListener('submit', async (e) => {
            e.preventDefault();
            const token = localStorage.getItem('gh_token');
            if (!token) return alert('No GitHub token found! Please login via the Admin Dashboard.');

            hSubmitBtn.disabled = true;
            hSubmitBtn.textContent = "Publishing...";
            hStatusMsg.classList.add('hidden');

            const title = document.getElementById('h-title').value;
            const category = document.getElementById('h-category').value;
            const tagsRaw = document.getElementById('h-tags').value;
            const date = document.getElementById('h-date').value;

            const tagsStr = tagsRaw ? tagsRaw.split(',').map(s => `"${s.trim()}"`).join(', ') : '';
            const markdown = `---\ntitle: "${title.replace(/"/g, '\\"')}"\ncategory: "${category.replace(/"/g, '\\"')}"\ndate: ${date}\ntags: [${tagsStr}]\n---\n`;
            const filename = title.toLowerCase().replace(/[^a-z0-9]+/g, '-') + '.md';
            const path = `src/content/hobbies/${filename}`;

            try {
                const encodedContent = btoa(unescape(encodeURIComponent(markdown)));
                const response = await fetch(`https://api.github.com/repos/${REPO}/contents/${path}`, {
                    method: 'PUT',
                    headers: { 'Authorization': `token ${token}`, 'Content-Type': 'application/json' },
                    body: JSON.stringify({ message: `Add hobby: ${title}`, content: encodedContent })
                });

                if (response.ok) {
                    hStatusMsg.textContent = "✅ Published! Live in 60s.";
                    hStatusMsg.className = "text-center font-bold text-sm mt-2 text-green-600 block";
                    setTimeout(() => { hModal.style.display = 'none'; hForm.reset(); }, 2000);
                } else {
                    const error = await response.json();
                    throw new Error(error.message || "Failed to publish");
                }
            } catch (err) {
                hStatusMsg.textContent = "❌ Error: " + err.message;
                hStatusMsg.className = "text-center font-bold text-sm mt-2 text-red-600 block";
            } finally {
                hSubmitBtn.disabled = false;
                hSubmitBtn.textContent = "Publish Interest";
            }
        });
    </script>
</Layout>
