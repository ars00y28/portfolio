---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const allHobbies = await getCollection('hobbies');
const sortedHobbies = allHobbies.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<Layout title="Personal Interests | Mechatronics Portfolio">
    <section class="py-12">
        <header class="mb-12">
            <h1 class="text-4xl font-extrabold text-gray-900 mb-4">Personal Interests</h1>
            <p class="text-xl text-gray-600 max-w-3xl">
                Beyond mechatronics, I am passionate about painting, sketching, writing, and human psychology. These interests shape my creative approach to engineering problems and human-centered design.
            </p>
        </header>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
            {sortedHobbies.map(hobby => (
                <div class="bg-white rounded-lg shadow-sm border border-gray-100 overflow-hidden hover:shadow-md transition-shadow">
                     <div class="h-64 bg-gray-200 w-full overflow-hidden relative">
                        {hobby.data.image ? (
                            <img src={hobby.data.image} alt={hobby.data.title} class="w-full h-full object-cover" />
                        ) : (
                            <div class="w-full h-full flex flex-col items-center justify-center text-gray-400 p-4 text-center">
                                <span class="font-bold text-gray-300 text-2xl mb-2">{hobby.data.category}</span>
                                <span>No Image uploaded yet</span>
                            </div>
                        )}
                        <span class="absolute top-4 right-4 bg-white/90 backdrop-blur-sm text-gray-800 text-xs font-bold px-3 py-1 rounded-full shadow-sm">
                            {hobby.data.category}
                        </span>
                    </div>
                    <div class="p-6">
                        <h2 class="text-xl font-bold text-gray-900 mb-2">{hobby.data.title}</h2>
                        <time class="text-xs text-gray-500 font-medium block mb-4">{hobby.data.date.toLocaleDateString()}</time>
                        <div class="flex flex-wrap gap-2">
                            {hobby.data.tags.map(tag => (
                                <span class="px-2 py-1 bg-gray-100 text-gray-600 text-xs rounded-md border border-gray-200">#{tag}</span>
                            ))}
                        </div>
                    </div>
                </div>
            ))}
        </div>
    </section>
</Layout>
