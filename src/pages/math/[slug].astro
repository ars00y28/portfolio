---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
    const projects = await getCollection('math');
    return projects.map(entry => ({
        params: { slug: entry.id },
        props: { entry },
    }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<Layout title={`${entry.data.title} | Art`}>
  <article class="max-w-4xl mx-auto reveal-on-scroll">
    <header class="mb-12 text-center">
      <h1 class="text-4xl md:text-6xl font-black text-slate-900 mb-4">{entry.data.title}</h1>
      <p class="text-xl text-slate-500 mb-8">{entry.data.date.toDateString()}</p>
    </header>

    {entry.data.video ? (
      <div class="w-full rounded-2xl overflow-hidden shadow-2xl bg-slate-900 mb-12 max-h-[80vh] flex justify-center">
        <video src={entry.data.video} controls class="w-full h-full object-contain max-h-[80vh]"></video>
      </div>
    ) : entry.data.image ? (
      <div class="w-full mb-12 flex justify-center">
        <img src={entry.data.image} alt={entry.data.title} class="max-w-full h-auto rounded-2xl shadow-xl max-h-[85vh] object-contain bg-slate-50 border border-slate-200" />
      </div>
    ) : null}

    <div class="prose prose-lg prose-slate max-w-2xl mx-auto text-center md:text-left">
      <Content />
    </div>
  </article>
</Layout>
